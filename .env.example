# =============================================================================
# ScribeNotes Environment Configuration Template
# Copy this file to .env and replace placeholder values with your actual config.
# Do NOT commit your actual .env file to version control.
# =============================================================================

# Server Port (Default: 5000)
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=production

# Database Credentials (used by Docker Compose)
MONGO_USER=admin
MONGO_PASSWORD=password
MONGO_DATABASE=user-account
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081

# MongoDB Connection String:
# 1. Local standalone MongoDB:
#    MONGO_URI=mongodb://localhost:27017/user-account
# 2. Local Docker container with auth:
#    MONGO_URI=mongodb://admin:password@localhost:27017/user-account?authSource=admin
# 3. Docker Compose internal network:
#    MONGO_URI=mongodb://admin:password@mongo:27017/user-account?authSource=admin
# 4. MongoDB Atlas (Cloud):
#    MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/user-account?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/user-account

# Allowed CORS Origins (comma-separated for multiple, or '*' for all)
CORS_ORIGIN=*
